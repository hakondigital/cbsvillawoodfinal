# Cloudflare Pages header rules. Without these, static assets are served with the
# platform default of max-age=14400, must-revalidate, so repeat visitors re-check
# every image on every visit.

# Build output is content-hashed, so it can be cached permanently.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Images keep stable filenames, so cache for 30 days rather than forever.
/images/*
  Cache-Control: public, max-age=2592000

/resources/*
  Cache-Control: public, max-age=2592000
